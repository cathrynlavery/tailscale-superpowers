#!/usr/bin/env python3
"""Print a verified Tailscale HTTPS link for something running on this computer.

    tailnet-url <local-port> [path]

Checks the app answers on 127.0.0.1:<port>, shares it with your tailnet through Tailscale Serve (reusing an
existing mapping when there is one), checks the tailnet link loads, and prints it. Give people that link, never
a localhost one: localhost only works on the machine running the app.
"""

import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

MAC_CLI = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"


def tailscale_cli():
    found = shutil.which("tailscale")
    if found:
        return found
    if os.path.exists(MAC_CLI):
        return MAC_CLI
    raise RuntimeError("Tailscale CLI not found (install Tailscale, or add the tailscale command to PATH)")


def tailscale(*args):
    result = subprocess.run([tailscale_cli(), *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip())
    return result.stdout


def check(url):
    try:
        with urllib.request.urlopen(url, timeout=8) as response:
            return response.status
    except urllib.error.HTTPError as error:
        return error.code


def main():
    if len(sys.argv) not in (2, 3):
        raise ValueError("usage: tailnet-url <local-port> [path]")
    port = int(sys.argv[1])
    if not 1 <= port <= 65535:
        raise ValueError("port must be between 1 and 65535")
    path = sys.argv[2] if len(sys.argv) == 3 else "/"
    if not path.startswith("/") or path.startswith("//"):
        raise ValueError("path must start with one /")

    local = f"http://127.0.0.1:{port}{path}"
    if not 200 <= check(local) < 400:
        raise RuntimeError(f"nothing is loading on local port {port}{path}")

    status = json.loads(tailscale("status", "--json"))
    dns = status["Self"]["DNSName"].rstrip(".")
    config = json.loads(tailscale("serve", "status", "--json") or "{}") or {}
    web = config.get("Web", {})
    target = f"http://127.0.0.1:{port}"
    existing = [host_port for host_port, value in web.items()
                if value.get("Handlers", {}).get("/", {}).get("Proxy") == target
                and config.get("TCP", {}).get(host_port.rsplit(":", 1)[-1], {}).get("HTTPS")]
    if existing:
        external = int(existing[0].rsplit(":", 1)[-1])
    else:
        occupied = {int(item.rsplit(":", 1)[-1]) for item in web}
        external = port if port not in occupied else next(
            candidate for candidate in range(18000, 19000) if candidate not in occupied)
        tailscale("serve", "--bg", f"--https={external}", target)

    suffix = "" if external == 443 else f":{external}"
    url = f"https://{dns}{suffix}{path}"
    if not 200 <= check(url) < 400:
        raise RuntimeError(f"Tailscale link did not load: {url}")
    print(url)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, ValueError, urllib.error.URLError, StopIteration) as error:
        print(f"tailnet-url: {error}", file=sys.stderr)
        raise SystemExit(1)
